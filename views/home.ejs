<!DOCTYPE html>
<html lang="en">
<head>
      <Style>
            body{
                  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            .urlTable{
                  border-collapse: collapse;
                  width: auto;
                  margin: 40px;
                  margin-left:60px ;
                  border: 1px solid black;
            }
            .urlTable thead,th,tr,td{
                  border: 1px solid black;
                  margin: 5px;
                  padding: 5px;
                  text-align: center ;
            }
      </Style>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Document</title>
</head>
<body>
      <h1>URL Shortener</h1>
      <% if(locals.id) {%>
            <p>URl Generated: http://localhost:8001/url/<%=id %></p>
      <% } %>
      <div>
            <form action="/url" method="post">
                  <label for="redirectUrl">Enter Original URL</label><br>
                  <input type="text" placeholder="Example@example.com" name="url"><br>
                  <button type="submit">Generate</button>
            </form>
      </div>
      <%if (locals.urls) { %>
            <table class="urlTable" >
                  <thead>
                        <tr>
                        <th>S NuMbeR</th>
                        <th>SHorT uRL</th>
                        <th>COmPletE UrL</th>
                        <th>CLIck CoUNt</th>

                        </tr>
                        
                  </thead>
                  <tbody>
                        <% urls.forEach((url,index) => { %>
                              <tr>
                                    <td><%= index +1 %> </td>
                                    <td><%= url.shortId%></td>
                                    <td><%= url.redirectUrl%></td>
                                    <td><%= url.visitHistory.length %></td>
                              </tr>
                           <%   }); %>
                  </tbody>
            </table>
     <% }%>
</body>
</html> 